# --- ИИ: любой OpenAI-совместимый сервис. Бесплатный вариант: Groq (https://console.groq.com/keys) ---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Список моделей, доступных твоему ключу: GET {LLM_BASE_URL}/models
# Для Gemini: LLM_PROVIDER=gemini и LLM_MODEL=<актуальная модель>

# --- Код доступа к сайту и API. Придумай длинную случайную строку ---
SERVICE_API_KEY=change-me

# --- Telegram (токен у @BotFather) ---
TELEGRAM_BOT_TOKEN=
# id учителей через запятую (свой id: @userinfobot). Пусто = бот открыт всем
TELEGRAM_ALLOWED_IDS=
# true на сервере: бот получает сообщения через webhook. Локально оставь false и запускай python bot.py
TELEGRAM_WEBHOOK=false

# --- Лимиты (по желанию) ---
API_RATE_LIMIT_PER_HOUR=60
BOT_RATE_LIMIT_PER_HOUR=10
