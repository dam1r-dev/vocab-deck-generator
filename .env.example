# --- ИИ (бесплатно: https://aistudio.google.com/apikey) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Для Groq / OpenRouter / OpenAI поставь LLM_PROVIDER=openai_compatible и:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Защита API (его вызывает Make.com). Придумай длинную случайную строку ---
SERVICE_API_KEY=change-me

# --- Telegram (получить у @BotFather). Нужен только для автономного бота ---
TELEGRAM_BOT_TOKEN=
# Через запятую id учителей, кому можно пользоваться ботом. Пусто = всем.
TELEGRAM_ALLOWED_IDS=
